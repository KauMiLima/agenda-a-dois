# Copie este arquivo para supabase/.env.secrets e preencha.
# Envie para o Supabase com:  npx supabase secrets set --env-file supabase/.env.secrets

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Seu e-mail (a Apple exige um contato válido)
VAPID_SUBJECT=mailto:seu-email@gmail.com
CRON_SECRET=
APP_TIMEZONE=America/Fortaleza

# Descomente e cole sua chave quando for ativar o assistente de IA
# ANTHROPIC_API_KEY=sk-ant-...
